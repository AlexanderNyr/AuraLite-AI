
# Python caches / build artifacts (tracked by accident before v2.6.2)
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Benchmark / profiling output (generated). Ignored files also survive
# `git clean -fd`: benchmarks/profiles/ holds the traces written by
# auralite.engine.profiling.torch_profile().
benchmarks/latest_generation.json
benchmarks/profiles/

# Build output: `python -m build`, PyInstaller (packaging/app/build_app.py, build_exe.bat)
build/
dist/
# A .spec PyInstaller writes when it runs without one; the app's own is tracked
# (packaging/app/auralite_app.spec), so only the root's are ignored.
/*.spec

# Reports the CI steps write when run locally
coverage.json
pyright.json

# 2.21: the app build environment (build_exe.bat)
.venv-app/
